# Valores PÚBLICOS para el build de producción (npm run build / Cloudflare).
# Se suben a git a propósito: ninguno es secreto (los secretos van con `wrangler secret put`).
# Tienen prioridad sobre .env al construir, así las claves de prueba locales nunca llegan a producción.

# Turnstile: vacío = el formulario abre WhatsApp (activar al tener dominio)
PUBLIC_TURNSTILE_SITE_KEY=

# Umami Cloud: Website ID del sitio (Settings -> Websites -> Edit)
PUBLIC_UMAMI_WEBSITE_ID=25e70ad1-1ab0-4d68-9f5d-86b429183892

# Google Search Console: valor "content" de la etiqueta HTML de verificación
PUBLIC_GOOGLE_SITE_VERIFICATION=n3db8BcbbY3qOjumZoZUwaY8sEuEYvnYZyLGmBf2m3k
