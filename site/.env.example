# Copia este archivo como .env (no se sube a git).
# En Cloudflare, configura las mismas variables en Settings -> Build -> Variables.

# Clave PÚBLICA de Cloudflare Turnstile. Vacía = el formulario abre WhatsApp.
# Para pruebas locales usa la clave de prueba de Cloudflare que siempre aprueba:
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# ID del sitio en Umami Cloud. Vacío = sin analítica.
PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
