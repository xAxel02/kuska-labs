---
const { scene, active = "web" } = Astro.props;
---
        <div class="stage" data-active={active}>
          <div class="scene scene-web">
            <div class="browser">
              <div class="bar"><i></i><i></i><i></i><span class="url"></span></div>
              <div class="page">
                <span class="nav"></span>
                <span class="h1"></span><span class="h1 short"></span>
                <span class="btn-mock"></span>
                <div class="tiles"><span></span><span></span><span></span></div>
              </div>
            </div>
          </div>
          <div class="scene scene-systems">
            <div class="app">
              <div class="side"><span></span><span></span><span></span><span></span></div>
              <div class="main">
                <div class="kpis"><span></span><span></span><span></span></div>
                <div class="woven" style="--cols: 10">
                  {[3, 5, 4, 6, 5, 7, 6, 8, 7, 9].map((h, i) => (
                    <span class="col" style={`--h:${h}; --i:${i}`}>{Array.from({ length: h }).map(() => <b />)}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <div class="scene scene-ai">
            <div class="chat">
              <p class="msg in">{scene.chatIn}</p>
              <p class="msg out">{scene.chatOut}</p>
              <p class="msg in">{scene.chatIn2}</p>
              <p class="msg sys">{scene.ok}</p>
            </div>
          </div>
          <div class="scene scene-care">
            <ul class="checks">
              <li><span class="ok"></span>{scene.backup}</li>
              <li><span class="ok"></span>{scene.updates}</li>
            </ul>
            <div class="uptime">{Array.from({ length: 30 }).map((_, i) => <b style={`--i:${i}`} />)}</div>
            <p class="uptime-label">{scene.uptime}</p>
          </div>
        </div>
<style>
  .stage {
    position: relative; display: grid; aspect-ratio: 4 / 3.4; min-height: 22rem; overflow: hidden;
    background: var(--color-surface-1); border: 1px solid var(--color-border); border-radius: var(--radius-lg);
  }
  .scene { position: relative; grid-area: 1 / 1; min-width: 0; padding: 1.5rem; display: grid; place-items: center; visibility: hidden; }
  .stage[data-active='web'] .scene-web,
  .stage[data-active='systems'] .scene-systems,
  .stage[data-active='ai'] .scene-ai,
  .stage[data-active='care'] .scene-care { visibility: visible; animation: px-reveal var(--dur-slow) var(--ease-step) both; }

  /* web */
  .browser { width: 100%; border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); overflow: hidden; background: var(--color-bg); }
  .bar { display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-bottom: 1px solid var(--color-border); }
  .bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--color-border-strong); }
  .url { flex: 1; height: 10px; margin-left: 8px; border-radius: 4px; background: var(--color-surface-2); }
  .page { display: flex; flex-direction: column; gap: 10px; padding: 16px; }
  .page span { display: block; border-radius: 4px; background: var(--color-surface-2); }
  .nav { height: 8px; width: 40%; }
  .h1 { height: 18px; width: 85%; background: var(--color-text) !important; opacity: 0.85; }
  .h1.short { width: 55%; }
  .btn-mock { height: 22px; width: 38%; background: var(--color-accent) !important; }
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 6px; }
  .tiles span { height: 44px; }

  /* sistemas */
  .app { width: 100%; height: 100%; display: grid; grid-template-columns: 22% 1fr; gap: 10px; }
  .side { display: flex; flex-direction: column; gap: 8px; padding: 10px; border-radius: var(--radius-md); background: var(--color-bg); }
  .side span { height: 10px; border-radius: 3px; background: var(--color-surface-2); }
  .side span:first-child { background: var(--color-accent); }
  .main { display: flex; flex-direction: column; gap: 10px; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .kpis span { height: 42px; border-radius: var(--radius-sm); background: var(--color-bg); border: 1px solid var(--color-border); }

  /* "Reporte tejido": barras hechas de cuadros en dos tonos de oro que se alternan como un textil */
  .woven {
    flex: 1; display: grid; grid-template-columns: repeat(var(--cols), 1fr); align-items: end; gap: 3px;
    padding: 10px; border-radius: var(--radius-md); background: var(--color-bg);
  }
  .col { display: flex; flex-direction: column-reverse; gap: 3px; }
  .col b { aspect-ratio: 1; background: var(--color-accent); border-radius: 1px; }
  .col b:nth-child(odd) { background: color-mix(in srgb, var(--color-accent) 55%, var(--color-bg)); }
  .col:nth-child(even) b:nth-child(odd) { background: var(--color-accent); }
  .col:nth-child(even) b:nth-child(even) { background: color-mix(in srgb, var(--color-accent) 55%, var(--color-bg)); }
  .stage[data-active='systems'] .col b { animation: weave-in var(--dur-base) steps(2, end) both; animation-delay: calc(var(--i) * 60ms + var(--dur-base)); }
  @keyframes weave-in { from { opacity: 0; transform: translateY(4px); } }

  /* IA */
  .chat { width: 100%; display: flex; flex-direction: column; gap: 10px; }
  .msg { max-width: 80%; padding: 0.6rem 0.85rem; border-radius: 12px; font-size: var(--text-small); line-height: 1.4; }
  .msg.in { align-self: flex-start; background: var(--color-surface-2); color: var(--color-text); border-bottom-left-radius: 4px; }
  .msg.out { align-self: flex-end; background: var(--color-accent); color: var(--color-on-accent); border-bottom-right-radius: 4px; }
  .msg.sys { align-self: center; font-size: var(--text-label); color: var(--color-accent); background: var(--color-accent-soft); }
  .stage[data-active='ai'] .msg { animation: px-reveal var(--dur-slow) steps(4, end) both; }
  .stage[data-active='ai'] .msg:nth-child(2) { animation-delay: 0.7s; }
  .stage[data-active='ai'] .msg:nth-child(3) { animation-delay: 1.4s; }
  .stage[data-active='ai'] .msg:nth-child(4) { animation-delay: 2.1s; }

  /* mantenimiento */
  .scene-care { align-content: center; gap: 1rem; }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; justify-self: stretch; }
  .checks li { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0.8rem; border-radius: var(--radius-md); background: var(--color-bg); font-size: var(--text-small); color: var(--color-text); }
  .ok { width: 14px; height: 14px; border-radius: 3px; background: var(--color-success); }
  .uptime { justify-self: stretch; display: grid; grid-template-columns: repeat(30, 1fr); gap: 3px; }
  .uptime b { aspect-ratio: 1 / 2.4; border-radius: 2px; background: var(--color-accent); }
  .stage[data-active='care'] .uptime b { animation: weave-in var(--dur-fast) steps(2, end) both; animation-delay: calc(var(--i) * 25ms + var(--dur-base)); }
  .uptime-label { justify-self: start; font-size: var(--text-label); color: var(--color-text-3); }


@media (prefers-reduced-motion: reduce) { .stage *, .stage .scene { animation: none !important; } }
</style>
