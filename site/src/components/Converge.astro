---
/**
 * Cierre del recorrido: los cuatro nodos del "flujo vivo" (WhatsApp, IA, sistema, reporte)
 * llegan desde las esquinas y se funden en la chakana mientras esta se ensambla con el scroll.
 * Decorativo (aria-hidden). Sin soporte o con movimiento reducido: chakana armada, sin íconos.
 */
import Chakana from './Chakana.astro';
---

<div class="converge" aria-hidden="true">
  <span class="node n-tl"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z" /></svg></span>
  <span class="node n-tr"><svg viewBox="0 0 24 24"><rect x="5" y="8" width="14" height="11" rx="2" /><path d="M12 4v4M9 13h.01M15 13h.01" /></svg></span>
  <span class="node n-bl"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" /></svg></span>
  <span class="node n-br"><svg viewBox="0 0 24 24"><path d="M4 20h16M7 16v-5M12 16V7M17 16v-8" /></svg></span>
  <div class="core"><Chakana mode="scroll" /></div>
</div>

<style>
  .converge { position: relative; width: 168px; height: 112px; }
  .core { position: absolute; left: 0; top: 50%; width: 76px; transform: translateY(-50%); }
  .node {
    position: absolute; width: 34px; height: 34px; display: none; place-items: center;
    border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-surface-1);
  }
  .node svg { width: 18px; height: 18px; fill: none; stroke: var(--color-accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .n-tl { left: 76px; top: 0; }
  .n-tr { left: 134px; top: 0; }
  .n-bl { left: 76px; bottom: 0; }
  .n-br { left: 134px; bottom: 0; }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .converge { view-timeline-name: --converge; }
      .node {
        display: grid;
        animation: node-in linear both;
        animation-timeline: --converge;
        animation-range: entry 0% cover 45%;
      }
      /* cada nodo termina en el centro de la chakana (38px, 56px) */
      .n-tl { --tx: -55px; --ty: 39px; }
      .n-tr { --tx: -113px; --ty: 39px; }
      .n-bl { --tx: -55px; --ty: -39px; }
      .n-br { --tx: -113px; --ty: -39px; }
    }
  }
  @keyframes node-in {
    0% { transform: none; opacity: 0; }
    20% { opacity: 1; }
    75% { opacity: 1; transform: translate(calc(var(--tx) * 0.8), calc(var(--ty) * 0.8)) scale(0.8); }
    100% { opacity: 0; transform: translate(var(--tx), var(--ty)) scale(0.3); }
  }
</style>
