---
import WhatsAppIcon from '../WhatsAppIcon.astro';
import Converge from '../Converge.astro';
import { WHATSAPP_NUMBER, CONTACT_EMAIL, TURNSTILE_SITE_KEY, CONTACT_ENDPOINT, whatsappLink } from '../../config';
import { useTranslations, privacyPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

/*
 * Dos modos (se elige solo, según la configuración):
 *  - "api": hay PUBLIC_TURNSTILE_SITE_KEY -> se envía a /api/contacto (Worker: Turnstile + D1 + correo).
 *  - "whatsapp": sin clave -> se abre WhatsApp con el mensaje armado (no requiere backend).
 */
const mode = TURNSTILE_SITE_KEY ? 'api' : 'whatsapp';
const waHref = whatsappLink(t('whatsapp.message'));
---

<section id="contacto" class="section" aria-labelledby="contact-title">
  <div class="container inner">
    <div class="section-head">
      <div class="contact-mark"><Converge /></div>
      <h2 id="contact-title">{t('contact.title')}</h2>
      <p>{t('contact.lead')}</p>
      <div class="direct">
        <a class="btn btn-secondary" href={waHref} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-location="contact">
          <WhatsAppIcon /> {t('cta.whatsapp')}
        </a>
        <a class="mail" href={`mailto:${CONTACT_EMAIL}`} data-umami-event="email" data-umami-event-location="contact">{CONTACT_EMAIL}</a>
      </div>
    </div>

    <div class="card form-card">
      <form
        id="contact-form"
        class="form"
        method="post"
        action={CONTACT_ENDPOINT}
        novalidate
        data-mode={mode}
        data-wa={WHATSAPP_NUMBER}
        data-lang={lang}
        data-msg-required={t('form.required')}
        data-msg-consent={t('form.consentRequired')}
        data-msg-contact={t('form.contactInvalid')}
        data-msg-captcha={t('form.errorCaptcha')}
        data-msg-generic={t('form.errorGeneric')}
        data-msg-sending={t('form.sending')}
      >
        <input type="hidden" name="lang" value={lang} />
        <!-- Honeypot antispam: oculto para personas -->
        <div class="hp" aria-hidden="true">
          <label for="f-kl-hp">No completar</label>
          <input id="f-kl-hp" name="kl_hp" type="text" tabindex="-1" autocomplete="off" data-lpignore="true" data-1p-ignore data-bwignore data-form-type="other" />
        </div>

        <div class="field">
          <label for="f-name">{t('form.name')}</label>
          <input id="f-name" name="name" type="text" autocomplete="name" maxlength="120" required aria-describedby="err-name" />
          <p class="field-error" id="err-name" hidden></p>
        </div>
        <div class="field">
          <label for="f-contact">{t('form.contact')}</label>
          <input id="f-contact" name="contact" type="text" inputmode="email" autocomplete="email" maxlength="160" required aria-describedby="hint-contact err-contact" />
          <p class="hint" id="hint-contact">{t('form.contactHint')}</p>
          <p class="field-error" id="err-contact" hidden></p>
        </div>
        <div class="field">
          <label for="f-business">{t('form.business')}</label>
          <input id="f-business" name="business" type="text" maxlength="160" placeholder={t('form.businessPlaceholder')} />
        </div>
        <div class="field">
          <label for="f-message">{t('form.message')}</label>
          <textarea id="f-message" name="message" rows="4" maxlength="4000" required aria-describedby="err-message"></textarea>
          <p class="field-error" id="err-message" hidden></p>
        </div>

        <div class="consent">
          <input id="f-consent" name="consent" type="checkbox" value="yes" required aria-describedby="err-consent" />
          <label for="f-consent">
            {t('form.consentPre')}<a href={privacyPath(lang)} target="_blank">{t('form.consentLink')}</a>{t('form.consentPost')}
          </label>
        </div>
        <p class="field-error" id="err-consent" hidden></p>

        {
          mode === 'api' && (
            <div
              class="cf-turnstile"
              data-sitekey={TURNSTILE_SITE_KEY}
              data-theme="dark"
              data-appearance="interaction-only"
              data-language={lang}
            />
          )
        }

        <p class="error" role="alert" hidden></p>

        <button class="btn btn-primary" type="submit">{t('form.submit')}</button>
        <p class="note">{mode === 'api' ? t('form.noteApi') : t('form.note')}</p>
      </form>

      <div class="success" hidden tabindex="-1">
        <h3>{t('form.successTitle')}</h3>
        <p>{t('form.successText')}</p>
        <a class="btn btn-secondary" href={waHref} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-location="form-success">
          <WhatsAppIcon /> {t('cta.whatsapp')}
        </a>
      </div>
    </div>
  </div>
</section>

{mode === 'api' && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  type Field = HTMLInputElement | HTMLTextAreaElement;
  declare global {
    interface Window {
      umami?: { track: (event: string, data?: Record<string, string>) => void };
      turnstile?: { reset: (el?: string | HTMLElement) => void };
    }
  }

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const msg = form.dataset;
    const errorBox = form.querySelector<HTMLParagraphElement>('.error')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const buttonLabel = button.textContent ?? '';
    const success = form.parentElement!.querySelector<HTMLDivElement>('.success')!;
    const track = (event: string, data?: Record<string, string>) => window.umami?.track(event, data);

    const showError = (text: string) => {
      errorBox.textContent = text;
      errorBox.hidden = false;
    };

    // Errores junto a cada campo (enlazados con aria-describedby), en lugar del globo nativo del navegador
    const setFieldError = (el: Field, text: string) => {
      const box = form.querySelector<HTMLElement>(`#err-${el.id.replace('f-', '')}`);
      if (box) { box.textContent = text; box.hidden = !text; }
      if (text) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
    };
    // Acepta un correo o un número (mínimo 7 dígitos, con o sin +51, espacios o guiones)
    const validContact = (v: string) =>
      v.includes('@')
        ? /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)
        : /^\+?[\d\s().-]{7,20}$/.test(v) && v.replace(/\D/g, '').length >= 7;

    const validate = (): boolean => {
      let firstInvalid: Field | null = null;
      const fail = (el: Field, text: string) => { setFieldError(el, text); if (!firstInvalid) firstInvalid = el; };
      form.querySelectorAll<Field>('input[required]:not([type="checkbox"]), textarea[required]').forEach((el) => {
        const v = el.value.trim();
        if (!v) fail(el, msg.msgRequired ?? '');
        else if (el.id === 'f-contact' && !validContact(v)) fail(el, msg.msgContact ?? '');
        else setFieldError(el, '');
      });
      const consent = form.querySelector<HTMLInputElement>('#f-consent')!;
      if (!consent.checked) fail(consent, msg.msgConsent ?? ''); else setFieldError(consent, '');
      if (firstInvalid) { (firstInvalid as Field).focus(); return false; }
      return true;
    };

    form.querySelectorAll<Field>('input, textarea').forEach((el) =>
      el.addEventListener(el.type === 'checkbox' ? 'change' : 'input', () => {
        if (el.getAttribute('aria-invalid')) setFieldError(el, '');
        errorBox.hidden = true;
      }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;
      if (!validate()) return;
      const data = new FormData(form);

      // Modo WhatsApp: arma el mensaje y abre el chat
      if (msg.mode === 'whatsapp') {
        const es = msg.lang === 'es';
        const lines = es
          ? ['Hola Kuska Labs, quiero agendar un diagnóstico gratis.', `Nombre: ${data.get('name')}`, `Contacto: ${data.get('contact')}`, `Negocio: ${data.get('business') || '-'}`, `Necesito: ${data.get('message')}`]
          : ["Hi Kuska Labs, I'd like to book a free discovery call.", `Name: ${data.get('name')}`, `Contact: ${data.get('contact')}`, `Business: ${data.get('business') || '-'}`, `I need: ${data.get('message')}`];
        track('form-submit', { mode: 'whatsapp' });
        window.open(`https://wa.me/${msg.wa}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
        return;
      }

      // Modo API: envía al Worker
      button.disabled = true;
      button.textContent = msg.msgSending ?? '…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (res.ok && body.ok) {
          track('form-submit', { mode: 'api' });
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        track('form-error', { reason: body.error ?? String(res.status) });
        showError(body.error === 'captcha' ? msg.msgCaptcha ?? '' : msg.msgGeneric ?? '');
      } catch {
        track('form-error', { reason: 'network' });
        showError(msg.msgGeneric ?? '');
      } finally {
        button.disabled = false;
        button.textContent = buttonLabel;
        window.turnstile?.reset();
      }
    });
  }
</script>

<style>
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: start; }
  .contact-mark { margin-bottom: 1.5rem; }
  .direct { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }
  .mail { font-size: var(--text-small); }
  .form-card { padding: clamp(1.5rem, 1rem + 2vw, 2.25rem); }
  .form { display: flex; flex-direction: column; gap: 1.125rem; }
  .form[hidden], .success[hidden] { display: none; }
  .field { display: flex; flex-direction: column; gap: 0.375rem; }
  label { font-size: var(--text-small); font-weight: var(--weight-medium); color: var(--color-text); }
  input:not([type='checkbox']), textarea {
    width: 100%; padding: 0.75rem 0.875rem; min-height: 48px;
    background: var(--color-surface-2); border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md); color: var(--color-text);
  }
  input::placeholder, textarea::placeholder { color: var(--color-text-3); }
  input:focus-visible, textarea:focus-visible { border-color: var(--color-accent); }
  [aria-invalid='true'] { border-color: var(--color-error) !important; }
  .hint { font-size: var(--text-label); color: var(--color-text-3); }
  .field-error { font-size: var(--text-small); color: var(--color-error); }
  .consent input[aria-invalid='true'] { outline: 2px solid var(--color-error); outline-offset: 2px; }
  textarea { resize: vertical; }
  .consent { display: flex; gap: 0.75rem; align-items: flex-start; }
  .consent input { width: 20px; height: 20px; margin: 2px 0 0; flex: none; accent-color: var(--color-accent); }
  .consent label { font-weight: var(--weight-regular); color: var(--color-text-2); line-height: 1.5; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .error {
    font-size: var(--text-small); color: var(--color-error);
    border: 1px solid var(--color-error); border-radius: var(--radius-md); padding: 0.75rem 0.875rem;
  }
  .form .btn { margin-top: 0.25rem; }
  .form .btn:disabled { opacity: 0.7; cursor: progress; }
  .note { font-size: var(--text-label); color: var(--color-text-3); }
  .success { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; outline: none; }
  .success h3 { font-size: var(--text-h3); }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; gap: 1rem; } }
</style>
