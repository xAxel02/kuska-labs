---
import { getCollection, render } from 'astro:content';
import { SHOW_PRICES } from '../../config';
import { useTranslations, formatPrice } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const services = (await getCollection('services', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const items = await Promise.all(services.map(async (s) => ({ ...s, Content: (await render(s)).Content })));
---

<section id="servicios" class="section" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <p class="label">{t('services.label')}</p>
      <h2 id="services-title">{t('services.title')}</h2>
      <p>{t('services.lead')}</p>
    </div>

    <ul class="grid" role="list">
      {
        items.map(({ data, Content }, i) => (
          <li class="card">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{data.title}</h3>
            <p class="summary">{data.summary}</p>
            <div class="body"><Content /></div>
            {SHOW_PRICES && (
              <p class="price">
                {t('services.from')} {formatPrice(lang, data.priceFrom)}
                {data.billing === 'monthly' && ` ${t('services.perMonth')}`}
                {data.billing === 'plus-monthly' && ` ${t('services.monthly')}`}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .card { display: flex; flex-direction: column; }
  .num { font-family: var(--font-mono); font-size: var(--text-label); color: var(--color-accent); margin-bottom: 1rem; }
  .summary { color: var(--color-text); }
  .body { margin-top: 0.5rem; font-size: var(--text-small); color: var(--color-text-3); }
  .price { margin-top: auto; padding-top: 1.25rem; font-family: var(--font-mono); font-size: var(--text-small); color: var(--color-text); }
</style>
