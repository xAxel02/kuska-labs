---
/**
 * Servicios agrupados en 4 bloques (web, sistemas, IA, mantenimiento) en filas, no tarjetas.
 * En escritorio, un panel fijo a la izquierda muestra una mini escena del grupo que estás leyendo
 * y se transforma al pasar al siguiente (IntersectionObserver). En móvil el panel se oculta.
 */
import ServiceStage from '../ServiceStage.astro';
import { getCollection, render } from 'astro:content';
import { SHOW_PRICES } from '../../config';
import { useTranslations, formatPrice, servicePath, slugOf } from '../../i18n/utils';
import type { Lang, UIKey } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const services = (await getCollection('services', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const items = await Promise.all(services.map(async (s) => ({ ...s, Content: (await render(s)).Content })));

const groups = (['web', 'systems', 'ai', 'care'] as const).map((g) => ({
  id: g,
  title: t(`services.group.${g}` as UIKey),
  text: t(`services.group.${g}.text` as UIKey),
  items: items.filter((i) => i.data.group === g),
}));

const scene = {
  es: { chatIn: '¿Atienden el sábado?', chatOut: 'Sí, de 9 a 1. ¿Te reservo una hora?', chatIn2: 'Sí, a las 10', ok: 'Reservado para el sábado 10:00', backup: 'Copia de seguridad', updates: 'Actualizaciones', uptime: 'En línea los últimos 30 días' },
  en: { chatIn: 'Are you open on Saturday?', chatOut: 'Yes, 9 to 1. Shall I book you a slot?', chatIn2: 'Yes, at 10', ok: 'Booked for Saturday 10:00', backup: 'Backup', updates: 'Updates', uptime: 'Online for the last 30 days' },
}[lang];
---

<section id="servicios" class="section" aria-labelledby="services-title">
  <div class="container services-container">
    <div class="section-head">
      <h2 id="services-title">{t('services.title')}</h2>
      <p>{t('services.lead')}</p>
    </div>

    <div class="layout" data-services>
      <!-- Panel que se transforma (decorativo) -->
      <div class="stage-wrap" aria-hidden="true">
        <ServiceStage scene={scene} />
      </div>

      <div class="groups">
        {
          groups.map((g) => (
            <div class="group" data-group={g.id}>
              <div class="group-head">
                <h3>{g.title}</h3>
                <p>{g.text}</p>
              </div>
              <ul class="rows" role="list">
                {g.items.map(({ id, data, Content }) => (
                  <li class="row">
                    <div class="row-main">
                      <h4><a style={`view-transition-name:svc-${slugOf(id)}`} href={servicePath(lang, slugOf(id))}>{data.title}</a></h4>
                      <p class="summary">{data.summary}</p>
                      <div class="body"><Content /></div>
                      <a class="service-link" href={servicePath(lang, slugOf(id))}>{t('services.view')} →</a>
                    </div>
                    {SHOW_PRICES && (
                      <p class="price">
                        <span class="from">{t('services.from')}</span>
                        <strong>{formatPrice(lang, data.priceFrom)}</strong>
                        {data.billing === 'monthly' && <span class="unit">{t('services.perMonth')}</span>}
                        {data.billing === 'plus-monthly' && <span class="unit">{t('services.monthly')}</span>}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
              <div class="inline-stage" aria-hidden="true"><ServiceStage scene={scene} active={g.id} /></div>
            </div>
          ))
        }
        {SHOW_PRICES && <p class="price-note">{t('services.priceNote')}</p>}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-services]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.stage-wrap [data-active]')!;
    const groups = root.querySelectorAll<HTMLElement>('[data-group]');
    if (!('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const id = (e.target as HTMLElement).dataset.group!;
          stage.dataset.active = id;
          groups.forEach((g) => g.classList.toggle('is-active', g === e.target));
        }),
      { rootMargin: '-40% 0px -55% 0px' }, // el grupo que cruza la franja central es el activo
    );
    groups.forEach((g) => io.observe(g));
  });
</script>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }

  /* ---------- Panel ---------- */
  .stage-wrap { position: sticky; top: 110px; }
  /* ---------- Lista ---------- */
  .group { padding-block: 0.5rem 2.5rem; }
  .group-head { padding-bottom: 1rem; border-bottom: 1px solid var(--color-border-strong); }
  .group-head h3 { font-size: var(--text-h3); color: var(--color-text-2); transition: color var(--dur-base); }
  .group.is-active .group-head h3 { color: var(--color-accent); }
  .group-head p { margin-top: 0.25rem; font-size: var(--text-small); color: var(--color-text-3); }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: flex; justify-content: space-between; gap: 1.5rem; padding-block: 1.25rem; border-bottom: 1px solid var(--color-border); }
  .row h4 { font-family: var(--font-display); font-weight: var(--weight-medium); font-size: var(--text-h4); color: var(--color-text); }
  .row h4 a { color: inherit; text-decoration: none; }
  .row h4 a:hover { color: var(--color-accent); }
  .summary { margin-top: 0.25rem; color: var(--color-text-2); }
  .body { margin-top: 0.25rem; font-size: var(--text-small); color: var(--color-text-3); }
  .service-link { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; margin-top: 0.65rem; font-size: var(--text-small); }
  .price { flex: none; text-align: right; display: flex; flex-direction: column; align-items: flex-end; font-variant-numeric: tabular-nums; }
  .price .from, .price .unit { font-size: 0.75rem; color: var(--color-text-3); }
  .price strong { font-family: var(--font-display); font-weight: var(--weight-bold); font-size: 1.25rem; color: var(--color-accent); line-height: 1.2; }
  .price-note { margin-top: 0.5rem; font-size: var(--text-small); color: var(--color-text-3); max-width: 60ch; }

  .services-container { container-type: inline-size; container-name: services; }
  .layout { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .stage-wrap { display: none; }
  .groups { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; min-width: 0; }
  .group { min-width: 0; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-1); }
  .group:first-child { border-radius: var(--radius-lg); }
  .row { flex-direction: column; gap: 0.5rem; }
  .row-main { min-width: 0; overflow-wrap: anywhere; }
  .inline-stage { margin-top: 1rem; }
  .price-note { grid-column: 1 / -1; }
  @container services (min-width: 38rem) {
    .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container services (min-width: 66rem) {
    .layout { grid-template-columns: minmax(0, 3fr) minmax(0, 7fr); }
    .stage-wrap { display: block; }
    .inline-stage { display: none; }
    .group:first-child { grid-column: span 2; }
    .group:last-of-type { grid-column: span 2; }
  }
  @media (max-width: 520px) {
    .row { flex-direction: column; gap: 0.5rem; }
    .price { align-items: flex-start; text-align: left; flex-direction: row; gap: 0.4rem; align-items: baseline; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage .scene, .stage .msg, .stage .col b, .stage .uptime b { animation: none !important; }
    .group-head h3 { transition: none; }
  }
</style>
