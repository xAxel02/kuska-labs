---
import { useTranslations } from '../../i18n/utils';
import { processSteps, type Lang } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const steps = processSteps[lang];
---

<section id="proceso" class="section" aria-labelledby="process-title">
  <div class="container">
    <div class="section-head">
      <h2 id="process-title">{t('process.title')}</h2>
      <p>{t('process.lead')}</p>
    </div>

    <ol class="steps" role="list">
      {
        steps.map((s, i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0;
    border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden;
  }
  .steps li { padding: 1.5rem; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .steps li:nth-child(4n) { border-right: 0; }
  .steps li:nth-last-child(-n + 4) { border-bottom: 0; }
  .n {
    display: inline-grid; place-items: center; width: 36px; height: 36px; margin-bottom: 1rem;
    font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-small); color: var(--color-on-accent);
    background: var(--color-accent); border-radius: var(--radius-sm);
  }
  h3 { font-size: 1.125rem; margin-bottom: 0.375rem; }
  p { font-size: var(--text-small); }

  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps li:nth-child(4n) { border-right: 1px solid var(--color-border); }
    .steps li:nth-child(2n) { border-right: 0; }
    .steps li:nth-last-child(-n + 4) { border-bottom: 1px solid var(--color-border); }
    .steps li:nth-last-child(-n + 2) { border-bottom: 0; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
    .steps li { border-right: 0 !important; border-bottom: 1px solid var(--color-border) !important; }
    .steps li:last-child { border-bottom: 0 !important; }
  }
</style>
