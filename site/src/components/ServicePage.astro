---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { SHOW_PRICES, SITE_URL, whatsappLink } from '../config';
import { formatPrice, homePath, servicePath, slugOf, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  service: CollectionEntry<'services'>;
}

const { lang, service } = Astro.props;
const t = useTranslations(lang);
const slug = slugOf(service.id);
const { Content } = await render(service);
const allServices = (await getCollection('services', ({ id }) => id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);
const related = [
  ...allServices.filter((item) => item.id !== service.id && item.data.group === service.data.group),
  ...allServices.filter((item) => item.id !== service.id && item.data.group !== service.data.group),
].slice(0, 3);

const pagePath = servicePath(lang, slug);
const alternatePath = servicePath(lang === 'es' ? 'en' : 'es', slug);
const esPath = lang === 'es' ? pagePath : alternatePath;
const enPath = lang === 'en' ? pagePath : alternatePath;
const title = lang === 'es'
  ? `${service.data.title} en Trujillo | Kuska Labs`
  : `${service.data.title} in Trujillo, Peru | Kuska Labs`;
const description = lang === 'es'
  ? `${service.data.summary} Desarrollo desde Trujillo para todo el Perú y el extranjero. Agenda tu diagnóstico gratis.`
  : `${service.data.summary} Built from Trujillo for clients across Peru and abroad. Book your free discovery call.`;
const heading = lang === 'es'
  ? `${service.data.title} en Trujillo`
  : `${service.data.title} in Trujillo, Peru`;

const faqs = lang === 'es'
  ? [
      { q: `¿Cuánto cuesta el servicio de ${service.data.title.toLowerCase()} en Trujillo?`, a: SHOW_PRICES ? `El precio referencial empieza en ${formatPrice(lang, service.data.priceFrom)}. El monto final depende del alcance y lo acordamos por escrito después del diagnóstico gratis.` : 'El monto depende del alcance. Después del diagnóstico gratis te enviamos una propuesta clara por escrito.' },
      { q: '¿Cuánto demora el proyecto?', a: 'El plazo depende del alcance y las integraciones. Después del diagnóstico te entregamos un cronograma por etapas antes de empezar.' },
      { q: '¿Atienden fuera de Trujillo?', a: 'Sí. Trabajamos de forma remota con clientes de todo el Perú y del extranjero, con reuniones y avances en línea.' },
      { q: '¿Cómo se emite el comprobante?', a: 'Cada profesional independiente del equipo emite recibo por honorarios electrónico por su participación en el proyecto.' },
    ]
  : [
      { q: `How much does the ${service.data.title.toLowerCase()} service cost?`, a: SHOW_PRICES ? `The starting price is ${formatPrice(lang, service.data.priceFrom)}. The final amount depends on scope and is agreed in writing after the free discovery call.` : 'Pricing depends on scope. After the free discovery call, we send you a clear written proposal.' },
      { q: 'How long does the project take?', a: 'Timing depends on scope and integrations. After the discovery call, we provide a staged schedule before work begins.' },
      { q: 'Do you work with clients outside Trujillo?', a: 'Yes. We work remotely with clients across Peru and abroad, using online meetings and regular progress reviews.' },
      { q: 'What payment document do you issue?', a: 'Each independent professional on the team issues an electronic fee receipt (recibo por honorarios) for their work on the project.' },
    ];

const areaServed = [
  { '@type': 'City', name: 'Trujillo' },
  { '@type': 'State', name: 'La Libertad' },
  { '@type': 'Country', name: 'Peru' },
];
const serviceJsonLd: Record<string, unknown> = {
  '@type': 'Service',
  '@id': `${SITE_URL}${pagePath}#service`,
  name: service.data.title,
  description,
  url: `${SITE_URL}${pagePath}`,
  provider: { '@id': `${SITE_URL}/#org` },
  areaServed,
  ...(SHOW_PRICES ? { offers: { '@type': 'Offer', price: service.data.priceFrom.pen, priceCurrency: 'PEN', url: `${SITE_URL}${pagePath}` } } : {}),
};
const faqJsonLd = {
  '@type': 'FAQPage',
  '@id': `${SITE_URL}${pagePath}#faq`,
  mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: `${SITE_URL}${homePath(lang)}` },
    { '@type': 'ListItem', position: 2, name: t('nav.services'), item: `${SITE_URL}${homePath(lang)}#servicios` },
    { '@type': 'ListItem', position: 3, name: service.data.title, item: `${SITE_URL}${pagePath}` },
  ],
};
---

<Layout
  lang={lang}
  title={title}
  description={description}
  alternates={{ es: esPath, en: enPath }}
  structuredData={[serviceJsonLd, faqJsonLd, breadcrumbJsonLd]}
>
  <article class="service-page">
    <header class="service-hero container">
      <a class="back" href={`${homePath(lang)}#servicios`}>← {t('service.back')}</a>
      <h1 style={`view-transition-name:svc-${slug}`}>{heading}</h1>
      <p class="summary">{service.data.summary}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`${homePath(lang)}#contacto`} data-umami-event="cta-diagnosis" data-umami-event-location="service">{t('cta.diagnosis')}</a>
        <a class="btn btn-secondary" href={whatsappLink(t('whatsapp.message'))} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-location="service"><WhatsAppIcon /> {t('cta.whatsapp')}</a>
      </div>
    </header>

    <div class="container content-grid">
      <div class="main-copy">
        <section class="body card" aria-label={service.data.title}><Content /></section>

        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">{t('service.faq')}</h2>
          <div class="faq-list">
            {faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}
          </div>
        </section>
      </div>

      <aside class="price-card card">
        {SHOW_PRICES && (
          <>
            <p class="label">{t('service.price')}</p>
            <p class="price">{t('services.from')} <strong>{formatPrice(lang, service.data.priceFrom)}</strong></p>
            {service.data.billing === 'monthly' && <p>{t('services.perMonth')}</p>}
            {service.data.billing === 'plus-monthly' && <p>{t('services.monthly')}</p>}
            <p class="price-note">{t('services.priceNote')}</p>
          </>
        )}
      </aside>
    </div>

    <section class="related container" aria-labelledby="related-title">
      <h2 id="related-title">{t('service.related')}</h2>
      <div class="related-grid">
        {related.map((item) => (
          <a class="card related-card" href={servicePath(lang, slugOf(item.id))}>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="closing container card">
      <div><h2>{t('service.ctaTitle')}</h2><p>{t('service.ctaText')}</p></div>
      <a class="btn btn-primary" href={`${homePath(lang)}#contacto`}>{t('cta.diagnosis')}</a>
    </section>
  </article>
</Layout>

<style>
  .service-page { padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .service-hero { max-width: 900px; margin-bottom: clamp(3rem, 2rem + 3vw, 5rem); }
  .back { display: inline-block; margin-bottom: 1.5rem; font-size: var(--text-small); }
  .service-hero h1 { max-width: 16ch; }
  .summary { max-width: 60ch; margin-top: 1.25rem; font-size: var(--text-lead); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .content-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); gap: clamp(1.5rem, 1rem + 3vw, 4rem); align-items: start; }
  .body { font-size: var(--text-lead); }
  .body :global(p + p) { margin-top: 1rem; }
  .price-card { position: sticky; top: 96px; }
  .price { margin-top: 0.5rem; }
  .price strong { display: block; color: var(--color-accent); font-family: var(--font-display); font-size: var(--text-h3); }
  .price-note { margin-top: 1rem; color: var(--color-text-3); font-size: var(--text-small); }
  .faq { margin-top: clamp(3rem, 2rem + 3vw, 5rem); }
  .faq-list { margin-top: 1.5rem; border-top: 1px solid var(--color-border); }
  details { padding-block: 1rem; border-bottom: 1px solid var(--color-border); }
  summary { cursor: pointer; color: var(--color-text); font-weight: var(--weight-medium); }
  details p { margin-top: 0.75rem; }
  .related { margin-top: clamp(4rem, 3rem + 4vw, 7rem); }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .related-card { color: inherit; text-decoration: none; }
  .related-card p { margin-top: 0.5rem; }
  .closing { margin-top: 4rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .closing p { margin-top: 0.5rem; max-width: 60ch; }
  .closing .btn { flex: none; }
  @media (max-width: 800px) {
    .content-grid { grid-template-columns: 1fr; }
    .price-card { position: static; order: -1; }
    .related-grid { grid-template-columns: 1fr; }
    .closing { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 480px) { .actions .btn, .closing .btn { width: 100%; } }
  @media (max-height: 560px) and (orientation: landscape) { .price-card { position: static; } }
</style>
