---
import { CONTACT_EMAIL, whatsappLink } from '../config';
import { useTranslations, privacyPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <img src="/brand/kuska-logo.svg" alt="Kuska Labs" width="196" height="52" class="logo" loading="lazy" />
      <p class="tagline">{t('footer.tagline')}</p>
    </div>
    <div class="contact">
      <a href={whatsappLink(t('whatsapp.message'))} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-location="footer">{t('cta.whatsappShort')}</a>
      <a href={`mailto:${CONTACT_EMAIL}`} data-umami-event="email" data-umami-event-location="footer">{CONTACT_EMAIL}</a>
      <a href={privacyPath(lang)}>{t('footer.privacy')}</a>
    </div>
  </div>
  <div class="container legal">
    <p>{t('footer.legal')}</p>
    <p>© {year} Kuska Labs · {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); padding-block: 3rem 6rem; margin-top: 2rem; }
  .grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2rem; }
  .logo { height: 32px; width: auto; }
  .tagline { margin-top: 0.75rem; font-size: var(--text-small); }
  .contact { display: flex; flex-direction: column; gap: 0.5rem; font-size: var(--text-small); }
  .legal {
    margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem;
    font-size: var(--text-small); color: var(--color-text-3);
  }
</style>
