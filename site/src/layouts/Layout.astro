---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { BRAND, UMAMI_WEBSITE_ID, UMAMI_SCRIPT_URL } from '../config';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Rutas equivalentes si el slug cambia entre idiomas (ej. /privacidad/ y /en/privacy/) */
  alternates?: { es: string; en: string };
}

const { lang, title, description, noindex = false, alternates } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');

// Rutas equivalentes en cada idioma: por defecto /ruta <-> /en/ruta
const path = Astro.url.pathname;
const esPath = alternates?.es ?? path.replace(/^\/en(\/|$)/, '/');
const enPath = alternates?.en ?? (esPath === '/' ? '/en/' : `/en${esPath}`);
const site = Astro.site!;
const canonical = new URL(lang === 'es' ? esPath : enPath, site).href;
const altEs = new URL(esPath, site).href;
const altEn = new URL(enPath, site).href;
// Imagen para redes 1200x630 por idioma (se regenera con brand/og/render_og.py)
const ogImage = new URL(`/brand/og-${lang}.png`, site).href;
---

<!doctype html>
<html lang={lang === 'es' ? 'es-PE' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marca que hay JS antes de pintar: las animaciones de revelado solo ocultan contenido si JS puede mostrarlo -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Íconos (generados en brand/logo/final/web-icons) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B0B0F" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.title')} />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_PE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />

    <!-- Analítica sin cookies (Umami): solo si hay ID configurado. Eventos: atributos data-umami-event -->
    {
      UMAMI_WEBSITE_ID && (
        <script is:inline defer src={UMAMI_SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID} data-do-not-track="true" />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} altHref={lang === 'es' ? enPath : esPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat lang={lang} />

    <script>
      // Revelado en escalones de píxel (ver global.css): marca cada bloque al entrar en pantalla.
      const targets = document.querySelectorAll<HTMLElement>('.section-head, main .card, .steps, .flow-wrap');
      // Escalonado entre hermanos de una misma cuadrícula (máx. 4 pasos)
      targets.forEach((el) => {
        const siblings = el.parentElement ? [...el.parentElement.children] : [];
        el.style.setProperty('--reveal-i', String(Math.min(siblings.indexOf(el) % 3, 3)));
      });
      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
