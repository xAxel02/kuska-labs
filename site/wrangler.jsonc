// Cloudflare Workers: sirve el sitio estático (dist/) y el endpoint /api/contacto (worker/index.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuska-labs-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Solo /api/* pasa por el Worker; el resto se sirve directo como archivo estático
    "run_worker_first": ["/api/*"]
  },

  // Base de datos de leads (creada en el primer deploy, 2026-11-13).
  // Aplicar cambios de esquema: npm run db:migrate:remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuska-leads",
      "database_id": "206722d0-27d5-4087-afe0-453d7611fd41",
      "migrations_dir": "migrations"
    }
  ],

  // Correo al equipo vía Cloudflare Email Routing.
  // Requiere: dominio en Cloudflare + Email Routing activo + MAIL_TO verificado como destino.
  // DESACTIVADO hasta tener dominio: descomentar al activar Email Routing (los leads igual se guardan en D1).
  // "send_email": [
  //   { "name": "EMAIL", "destination_address": "kuskalabs.pe@gmail.com" }
  // ],

  "vars": {
    "MAIL_FROM": "web@kuskalabs.com",
    "MAIL_TO": "kuskalabs.pe@gmail.com"
  }
  // Secreto (no va aquí): npx wrangler secret put TURNSTILE_SECRET
}
