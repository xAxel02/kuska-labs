// Cloudflare Workers: sirve el sitio estático (dist/) y el endpoint /api/contacto (worker/index.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuska-labs-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Todo pasa primero por el Worker: redirige www y workers.dev al dominio principal
    // y atiende /api/*; el resto lo entrega como archivo estático (env.ASSETS).
    "run_worker_first": true
  },

  // La URL antigua sigue activa solo para redirigir (301) al dominio; las Preview URLs por versión
  // (<versión>-kuska-labs-web….workers.dev) no se redirigen y sirven para revisar cambios.
  "workers_dev": true,
  "preview_urls": true,

  // Dominio propio (Cloudflare crea el DNS y el certificado al desplegar)
  "routes": [
    { "pattern": "kuskalabs.com", "custom_domain": true },
    { "pattern": "www.kuskalabs.com", "custom_domain": true }
  ],

  // Base de datos de leads (creada en el primer deploy, 2026-11-13).
  // Aplicar cambios de esquema: npm run db:migrate:remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuska-leads",
      "database_id": "206722d0-27d5-4087-afe0-453d7611fd41",
      "migrations_dir": "migrations"
    }
  ],

  // Correo al equipo vía Cloudflare Email Routing (activo desde 2026-11-13).
  // El destino debe estar verificado en Email Routing; hola@kuskalabs.com también reenvía a este Gmail.
  "send_email": [
    { "name": "EMAIL", "destination_address": "kuskalabs.pe@gmail.com" }
  ],

  "vars": {
    "CANONICAL_HOST": "kuskalabs.com",
    "LEGACY_HOST": "kuska-labs-web.renatovr25.workers.dev",
    "MAIL_FROM": "web@kuskalabs.com",
    "MAIL_TO": "kuskalabs.pe@gmail.com"
  }
  // Secreto (no va aquí): npx wrangler secret put TURNSTILE_SECRET
}
